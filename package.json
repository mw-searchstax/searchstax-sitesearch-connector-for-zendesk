{
  "name": "searchstax-zendesk-connector",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build",
    "start:container": "node --experimental-transform-types scripts/container.ts",
    "db:migrate:mysql": "node scripts/migrate-mysql.ts",
    "db:inspect:mysql": "node scripts/inspect-mysql.ts",
    "test:local-install": "node --test deploy/local/install-tests.mjs"
  },
  "dependencies": {
    "mysql2": "3.24.3",
    "parse5": "8.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
