# Use independent randomly generated hex passwords (URL-safe).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generate once; retain independently of database backups.
CONFIG_ENCRYPTION_KEY=
# Optional: enables the HTTPS Zendesk article webhook endpoint.
WEBHOOK_SIGNING_SECRET=
# Optional: enables customer-managed Zendesk OAuth with PKCE.
ZENDESK_OAUTH_CLIENT_ID=
# Paste the identity printed by the explicit init command.
CONNECTOR_ID=
APP_VERSION=0.0.0-r08
